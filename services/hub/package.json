{
  "name": "@firefly-mesh/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply firefly-mesh-hub-db --local && node scripts/install-audit-triggers.mjs --local",
    "migrate:remote": "wrangler d1 migrations apply firefly-mesh-hub-db --remote && node scripts/install-audit-triggers.mjs --remote",
    "test:e2e": "tsx test/e2e.ts",
    "test:e2e:product-layer": "tsx test/product-layer.e2e.ts",
    "test:e2e:m5-m7": "tsx test/m5-m7.e2e.ts"
  },
  "dependencies": {
    "@firefly-mesh/proto": "workspace:*",
    "@firefly-mesh/shared": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "^1.2.8",
    "jose": "^6.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "nanoid": "^5.1.5",
    "resend": "^4.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260508.1",
    "@firefly-mesh/crypto": "workspace:*",
    "tsx": "^4.20.4",
    "wrangler": "^4.90.0"
  }
}
