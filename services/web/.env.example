# services/web env vars — dev defaults below; copy to .env.local for local dev.
# Production values managed by Cloudflare Pages dashboard (sprint B).

# Hub API base URL. Used by next.config.ts rewrites() to proxy /api/* requests.
# Browser always fetches /api/* same-origin; Next.js server-side proxies to hub.
NEXT_PUBLIC_HUB_URL=http://localhost:8787

# Optional — dashboard's own public URL (Better Auth uses this for OAuth callback
# state-keeping). Defaults to http://localhost:3000 in dev; set to the prod
# domain (e.g., https://app.firefly-mesh.com) for production.
# NEXT_PUBLIC_APP_URL=http://localhost:3000
