{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Sprint B B.2 — Cloudflare Workers (Static Assets) config for the
  // dashboard. OpenNext bundles next build output into .open-next/worker.js;
  // wrangler deploys that file as the Worker entry.
  //
  // B.3 will bind the custom domain (firefly-mesh.com or app.firefly-mesh.com
  // per Option B / Option A) via the Cloudflare dashboard or `wrangler.toml`
  // routes block once secrets + DNS are arranged. Until B.3 this config is
  // dev/preview only.
  "name": "firefly-mesh-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  // Production hardening — disable workers.dev auto URL + per-version previews
  // (mirrors services/hub/wrangler.toml). Public traffic only via custom
  // domains attached in B.3.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // NEXT_PUBLIC_HUB_URL is consumed by next.config.ts rewrites for /api/*
    // proxy. Local dev defaults to localhost:8787; B.3 overrides via Worker
    // bindings to https://hub.firefly-mesh.com.
    "NEXT_PUBLIC_HUB_URL": "http://localhost:8787",
    "NEXT_PUBLIC_APP_URL": "http://localhost:3000"
  }
}
