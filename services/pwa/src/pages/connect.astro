---
import '../styles/globals.css';
import { ConnectPage } from '../components/connect/ConnectPage';

const code = Astro.url.searchParams.get('code') ?? '';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connect device — Firefly Mesh</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('firefly-mesh.lang');
          var lang = stored === 'zh' || stored === 'en'
            ? stored
            : (navigator.language || 'en').toLowerCase().startsWith('zh') ? 'zh' : 'en';
          document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';
        } catch (e) { /* ignore */ }
      })();
    </script>
  </head>
  <body class="h-full bg-background text-foreground font-sans antialiased">
    <ConnectPage client:load code={code} />
  </body>
</html>
