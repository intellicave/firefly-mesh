---
import '../styles/globals.css';
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Firefly Mesh — AI Agent Collaboration Platform" />
    <title>Firefly Mesh</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="h-full bg-background text-foreground font-sans antialiased">
    <main class="flex min-h-full flex-col items-center justify-center px-6 py-24">
      <div class="flex flex-col items-center gap-6 text-center">
        <div class="flex items-center gap-3">
          <span class="text-4xl font-bold tracking-tight text-foreground">
            Firefly Mesh
          </span>
        </div>
        <p class="max-w-md text-lg text-muted-foreground">
          Coming soon
        </p>
      </div>
    </main>
  </body>
</html>
