    "ai": "^6.0.169",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "html-to-text": "^9.0.5",
    "mammoth": "^1.12.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
