  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./auth/better-auth": "./src/auth/better-auth.ts",
    "./auth/jwt": "./src/auth/jwt.ts",
    "./audit/log": "./src/audit/log.ts",
    "./boundary/catalog": "./src/boundary/catalog.ts",
    "./events/bus": "./src/events/bus.ts",
    "./hitl/engine": "./src/hitl/engine.ts",
    "./a2a/broker": "./src/a2a/broker.ts",
    "./a2a/protocol": "./src/a2a/protocol.ts",
    "./a2a/signing": "./src/a2a/signing.ts",
    "./llm/helper": "./src/llm/helper.ts",
    "./task/dispatcher": "./src/task/dispatcher.ts",
    "./knowledge/chunk": "./src/knowledge/chunk.ts",
    "./knowledge/parse": "./src/knowledge/parse.ts",
    "./knowledge/embed": "./src/knowledge/embed.ts",
    "./knowledge/upload": "./src/knowledge/upload.ts",
    "./knowledge/search": "./src/knowledge/search.ts",
    "./skill/loader": "./src/skill/loader.ts"
