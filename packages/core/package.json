{
  "name": "@firefly-mesh/core",
  "version": "0.1.0",
  "private": true,
  "description": "firefly-mesh server-side business logic library (no HTTP server).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./auth/better-auth": "./src/auth/better-auth.ts",
    "./audit/log": "./src/audit/log.ts",
    "./boundary/catalog": "./src/boundary/catalog.ts",
    "./events/bus": "./src/events/bus.ts",
    "./llm/helper": "./src/llm/helper.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "drizzle-kit migrate && tsx src/db/post-migrate.ts",
    "smoke:llm": "tsx src/llm/smoke.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@ai-sdk/anthropic": "^3.0.72",
    "@ai-sdk/google": "^3.0.65",
    "@ai-sdk/openai": "^3.0.54",
    "ai": "^6.0.169",
    "better-auth": "^1.6.9",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
