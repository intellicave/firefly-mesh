# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# OpenNext + Cloudflare Workers build output (sprint B B.2)
/.open-next/
.wrangler/
# cf-typegen output — regenerated on every `pnpm cf-typegen`
cloudflare-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# Note on prod env: Next loads .env.local BEFORE .env.production in env
# precedence, so .env.production is unreliable when .env.local exists
# (every dev has one with localhost values). The `deploy` script in
# package.json sets NEXT_PUBLIC_HUB_URL / NEXT_PUBLIC_APP_URL inline
# instead — single source of truth, no .env.production needed.

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
