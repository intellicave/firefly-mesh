# firefly-mesh self-host environment variables
# Copy to .env and fill in required values.

# === Database ===
POSTGRES_USER=firefly
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=firefly_mesh
POSTGRES_PORT=5432

# === Web server ===
WEB_PORT=3000

# === Better Auth ===
# Generate via:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# === Vercel AI Gateway (LLM routing) ===
# Get from https://vercel.com/dashboard/ai/gateway
AI_GATEWAY_API_KEY=

# === Optional ===
IMAGE_TAG=latest
